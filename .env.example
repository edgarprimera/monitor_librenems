# ==============================================================================
# Variables de entorno - LibreNMS ISP Monitoring Stack
# ==============================================================================

# Zona Horaria (ej: America/Caracas, America/Bogota, America/Santiago, America/Mexico_City)
TZ=America/Caracas

# Base de datos MariaDB
MYSQL_DATABASE=librenems
MYSQL_USER=librenems
MYSQL_PASSWORD=cambiar_por_password_seguro
MYSQL_ROOT_PASSWORD=cambiar_por_root_password_seguro

# Puerto web expuesto en el host
LIBRENEMS_WEB_PORT=8000
